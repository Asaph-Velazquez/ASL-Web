PORT=3001
HTTPS_PORT=3002
MONGODB_URI=mongodb://localhost:27017/asl-hotel
JWT_SECRET=change-this-to-a-secure-64-character-hex-string
CALL_JWT_SECRET=change-this-call-secret

NODE_ENV=development
USE_HTTPS=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,https://localhost:3002,http://localhost:8081,http://localhost:8082,http://localhost:19006

# Public route for the hotel operational WebSocket served by ASL-Web/server.
# This should not overlap with CALL_SERVER_PATH.
HOTEL_WS_PATH=/ws/hotel

# Temporary transition flag. Leave false to require the explicit HOTEL_WS_PATH
# and avoid competing with /calls on the public root.
ENABLE_LEGACY_ROOT_WS=false

# Public WebSocket URL exposed to mobile/web clients. Leave empty to derive the
# current public host and append CALL_SERVER_PATH automatically.
CALL_SERVER_URL=

# Path that the web backend proxy must expose publicly for call signaling.
# Keep this aligned with the proxy route implemented in index.js.
CALL_SERVER_PATH=/calls

# Local/private fallback used only when deriving a call URL from localhost or a
# private host. This keeps direct local development pointing at ASL-CallAPP.
CALL_SERVER_PORT=3101

# Internal upstream target for the proxy that forwards call HTTP/WebSocket
# traffic to ASL-CallAPP/server. This is not exposed directly to clients.
CALL_PROXY_TARGET=http://localhost:3101
